<?xml version="1.0" encoding="UTF-8"?>
<!-- nap's own file types, installed to share/mime/packages by `make install`. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-nap-tape">
    <comment>nap mixtape</comment>
    <!-- A plain tar of one folder: index, cover, and audio. Archive tools can still open it. -->
    <sub-class-of type="application/x-tar"/>
    <!-- Toolkits search theme by theme, so a generic icon the user's theme has (audio-x-generic,
         say) would beat our own in hicolor. Naming ours as the generic leaves nothing to outrank it. -->
    <generic-icon name="application-x-nap-tape"/>
    <glob pattern="*.tape"/>
    <!-- nap writes the index first, so a tape's first entry is "<its folder>/tape.jcard": that
         name is in the first tar header, or after one long-name header if the folder's name is
         very long. This is what tells a tape from any other tar, whatever the file is called. -->
    <magic priority="80">
      <match type="string" value="/tape.jcard" offset="0:612"/>
    </magic>
  </mime-type>
  <mime-type type="application/x-nap-jcard">
    <comment>nap J-card track listing</comment>
    <sub-class-of type="text/plain"/>
    <generic-icon name="application-x-nap-jcard"/>
    <glob pattern="*.jcard"/>
  </mime-type>
</mime-info>
